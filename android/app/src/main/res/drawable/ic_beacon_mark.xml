<?xml version="1.0" encoding="utf-8"?>
<!--
  LightBeacon mark: three concentric amber rings around a solid core.

  Vector rather than bitmap so it stays sharp at every density and on every
  launcher mask. The 108x108 viewport is the adaptive-icon canvas; the mark is
  drawn at 70% so the outer ring stays inside the 72dp safe zone and is never
  clipped by a circular, squircle or rounded-square mask.

  Geometry (centre 54,54, half-size 37.8):
    rings at 0.40 / 0.60 / 0.80 of the half-size, stroke 0.08
    core at 0.20
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M54,54 m-15.12,0 a15.12,15.12 0 1,0 30.24,0 a15.12,15.12 0 1,0 -30.24,0"
        android:strokeColor="#FFB020"
        android:strokeWidth="3.02"
        android:fillColor="@android:color/transparent" />

    <path
        android:pathData="M54,54 m-22.68,0 a22.68,22.68 0 1,0 45.36,0 a22.68,22.68 0 1,0 -45.36,0"
        android:strokeColor="#FFB020"
        android:strokeWidth="3.02"
        android:fillColor="@android:color/transparent" />

    <path
        android:pathData="M54,54 m-30.24,0 a30.24,30.24 0 1,0 60.48,0 a30.24,30.24 0 1,0 -60.48,0"
        android:strokeColor="#FFB020"
        android:strokeWidth="3.02"
        android:fillColor="@android:color/transparent" />

    <path
        android:pathData="M54,54 m-7.56,0 a7.56,7.56 0 1,0 15.12,0 a7.56,7.56 0 1,0 -15.12,0"
        android:fillColor="#FFB020" />
</vector>
